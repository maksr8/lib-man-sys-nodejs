        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var token = jsonData.token || (jsonData.data && jsonData.data.accessToken);",
                  "if(token) { pm.collectionVariables.set(\"userToken\", token); }",
                  "if(jsonData.user && jsonData.user.id) { pm.collectionVariables.set(\"userId\", jsonData.user.id); }"
                ],
